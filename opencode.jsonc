{
  // opencode reads opencode.jsonc (comments allowed). Merge into your project's existing config
  // if you have one. Runs entirely on free, open-weights models, and needs exactly ONE thing:
  //   - openrouter:  big open-weights models on OpenRouter's :free tier (needs OPENROUTER_API_KEY).
  //                  Free-key tier = 50 req/day and an agentic session burns hundreds: do the
  //                  one-time $10 credit purchase for 1,000/day.
  //
  // No local model server is required. A local Ollama tier is OPTIONAL and costs $0/unmetered —
  // see docs/local-models.md to stand one up and examples/opencode.overlay.example.jsonc for the
  // provider block + which pins to move. It is opt-in on purpose: a declared provider pointing at
  // a host that isn't running resolves silently to a dead endpoint, and agents pinned to it fail
  // with no useful error.
  //
  // Auto-discovered from .opencode/ (no config needed): agent/, command/, skills/, plugins/.
  // OpenCode also auto-discovers .claude/skills/ — so your existing superpowers skills work too.
  "$schema": "https://opencode.ai/config.json",

  // --- 1. Provider (OpenAI-compatible) -------------------------------------------------------
  // Agents reference models PROVIDER-PREFIXED (e.g. `model: openrouter/cohere/north-mini-code:free`).
  // ⚠️ The :free roster churns monthly. If a slug 404s: run `node tools/doctor.mjs` WITHOUT
  //    --offline — only the live round-trip catches a dead slug; the static catalog check can't
  //    (it only reflects what this file declares). Then swap in a live :free slug,
  //    `openrouter/openrouter/free` (auto-router), or a pennies-tier model below. A new slug must
  //    be ADDED to this provider's "models" map before any agent/command can pin it.
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (free open-weights)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"                   // free account: openrouter.ai/keys
      },
      "models": {
        // ── Round-tripped live 2026-08-29. Every PIN in this kit uses one of these. ──────────
        "nvidia/nemotron-3-ultra-550b-a55b:free":  { "name": "Nemotron 3 Ultra 550B — top reasoner, 1M ctx (~18s)" },
        "nvidia/nemotron-3-super-120b-a12b:free":  { "name": "Nemotron 3 Super 120B — reviewer/synthesizer (262k)" },
        "nvidia/nemotron-3.5-lightning:free":      { "name": "Nemotron 3.5 Lightning — fast fallback (1M ctx)" },
        "poolside/laguna-s-2.1:free":              { "name": "Laguna-S 2.1 118B — coding agent, executor (262k)" },
        "poolside/laguna-xs-2.1:free":             { "name": "Laguna-XS 2.1 — mechanical (/commit), fast (262k)" },
        "cohere/north-mini-code:free":             { "name": "North Mini Code 30B — tester (256k)" },
        "minimax/minimax-m3:free":                 { "name": "MiniMax M3 — reviewer-cheap/pr-review, VISION, 1M ctx" },
        "minimax/minimax-m2.7:free":               { "name": "MiniMax M2.7 — fast family-diverse fallback (~13s, 196k)" },
        "thinkingmachines/inkling-small:free":     { "name": "Inkling Small — designer/refuter/proposer-c, VISION, 1M ctx (~12s)" },

        // ── Declared but NOT pinned: reachable via `-m`, depended on by nothing. ────────────
        // Both Gemma :free endpoints timed out (>100s) on 2026-08-29 — the kit already described
        // this endpoint as "often saturated". Fine for a manual one-off, wrong for an agent pin.
        "google/gemma-4-31b-it:free":              { "name": "Gemma 4 31B — SATURATED, unpinned (262k)" },
        "google/gemma-4-26b-a4b-it:free":          { "name": "Gemma 4 26B MoE — SATURATED, unpinned, multimodal (262k)" }

        // ── REMOVED 2026-08-29 — verified broken by live round-trip. ────────────────────────
        // ⚠️ `opencode models` STILL LISTS the delisted ones, so the static catalog check PASSES
        //    and only a real call fails. Never re-add without a round-trip.
        //   "openai/gpt-oss-20b:free"              -> "unavailable for free" (was refuter PRIMARY)
        //   "nvidia/nemotron-3-nano-30b-a3b:free"  -> "unavailable for free" (was 3 fallbacks)
        //   "inclusionai/ling-3.0-tiny:free"       -> ProviderModelNotFound, slug is gone entirely
        //                                             (was proposer-b + refuter fallback)
        //
        // Pennies tier (paid but ~free) if a :free slug delists:
        //   "qwen/qwen3.7-flash"            ($0.03/M in, 1M ctx)
        //   "z-ai/glm-4.7-flash"            ($0.06/M in)
        //   "deepseek/deepseek-v4-flash-0731" ($0.09/M in, 1M ctx)
      }
    }
  },
  "model": "openrouter/poolside/laguna-s-2.1:free",   // Build/executor default. No automatic fallback exists for this key — if rate-limited, swap to another :free slug above (or a local one, if you added the optional Ollama tier)

  // --- 2. Always-on instructions (combined with AGENTS.md) ----------------------------------
  // Globs and even remote URLs are supported. This loads the rails + durable memory every turn.
  "instructions": [
    "AGENTS.md",
    "memory/MEMORY.md",
    ".cursor/rules/*.md"                            // harmless if absent; pulls any IDE rules too
  ],

  // --- 3. MCP servers (toggle with "enabled") -----------------------------------------------
  //
  // ⚠️ WINDOWS GOTCHA (causes "MCP error -32000 connection closed"):
  //   OpenCode spawns the command as a RAW process (no shell). On Windows, `npx`/`uvx` are
  //   `.cmd`/`.ps1` shims, NOT `.exe` — Windows refuses to exec them directly ("%1 is not a
  //   valid Win32 application"), the stdio pipe closes before the handshake, and you get -32000.
  //   FIX: wrap in `cmd /c ...` so cmd.exe (a real binary) resolves the shim via PATHEXT.
  //   On macOS/Linux drop the ["cmd","/c", ...] prefix — use the POSIX form in each comment.
  //   Locked-down npm? `npx -y` reaches the registry on every launch; if blocked, `npm i -g`
  //   the server from your registry mirror and point the command at the installed binary.
  "mcp": {
    // Retrieval over the pattern corpus. (Optional — /pattern and @patterns/<name> read files
    // directly and need NO MCP, so you can also just disable this and lose nothing functional.)
    "patterns": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "./patterns"],
      // POSIX: ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./patterns"]
      "enabled": true
    },
    // Authoritative API docs -> kills hallucinated APIs (top weak-model failure, esp. .NET).
    // Point at whatever docs MCP you use, or leave disabled. (Remote = no spawn, no cmd /c.)
    "docs": {
      "type": "remote",
      "url": "https://YOUR_DOCS_MCP",
      "enabled": false
    },
    // Repo awareness across multi-step work. NOTE: server-git is a PYTHON package — run via uvx
    // (pip/uv), NOT npx. (Earlier this pointed at npx and would never have started.)
    "git": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "mcp-server-git", "--repository", "."],
      // POSIX: ["uvx", "mcp-server-git", "--repository", "."]
      "enabled": false
    },
    // Cross-session semantic memory (search past conversations) — your CC episodic-memory analog.
    "episodic-memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      // POSIX: ["npx", "-y", "@modelcontextprotocol/server-memory"]
      "enabled": false
    },
    // Browser verification (E2E checks) — your CC playwright analog.
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp@latest"],
      // POSIX: ["npx", "-y", "@playwright/mcp@latest"]
      "enabled": false
    }
  }

  // --- 4. TDD lock (used by the tdd-lock plugin) --------------------------------------------
  // Not a config key — set in your shell before the executor implements:
  //   export TDD_LOCK_TESTS=1   (PowerShell:  $env:TDD_LOCK_TESTS = "1")
  // Unset it to deliberately change a test.
}
