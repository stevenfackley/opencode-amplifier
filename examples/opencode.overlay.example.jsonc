{
  // PERSONAL OVERLAY EXAMPLE — layer your private wiring (LAN model host, extra/paid model IDs)
  // over the generic kit. Keep a filled-in copy out of public repos.
  //
  // Scope: this overlay changes PROVIDERS (endpoints, credentials, which models exist).
  // It CANNOT re-pin an existing agent's model — see the note at the bottom of this file.
  //
  // Usage: merge into the project's opencode.jsonc, or keep as ~/.config/opencode/opencode.jsonc.
  "$schema": "https://opencode.ai/config.json",

  // Point the local tier at a LAN model server instead of localhost.
  // Stable addressing: give the box a real hostname (mDNS → macmini.local) or a DHCP
  // reservation — never pin a dynamic IP. See docs/local-models.md for the server side.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LAN)",
      "options": { "baseURL": "http://macmini.local:11434/v1" },
      "models": {
        "qwen3.5:9b":        { "name": "Qwen3.5 9B (LAN)" },
        "ornith:9b":         { "name": "Ornith 9B (LAN)" },
        "qwen3.5:4b":        { "name": "Qwen3.5 4B (LAN)" },
        "gemma4:12b-it-qat": { "name": "Gemma 4 12B QAT (LAN)" }
      }
    }
    // Paid "pennies tier" upgrades when a :free slug delists or rate limits bite —
    // add under the kit's openrouter provider:
    //   "qwen/qwen3.7-flash", "z-ai/glm-4.7-flash", "deepseek/deepseek-v4-flash-0731"
  },

  // Load personal conventions on top of the kit's AGENTS.md.
  "instructions": [
    "AGENTS.md",
    "memory/MEMORY.md"
  ]

  // ⚠️ You CANNOT re-pin an agent's model from this overlay. An `agent.<name>.model` key here is
  // SILENTLY IGNORED whenever the agent's .md carries a `model:` line — markdown frontmatter beats
  // JSON, and config precedence is remote → global → custom (OPENCODE_CONFIG) → project, so the
  // kit's own project config outranks a global overlay too. Verified with `opencode debug agent`:
  //
  //   .opencode/agent/x.md `model: ollama/qwen3.5:4b` + overlay `agent.x.model` -> md wins
  //   .opencode/agent/x.md with NO `model:` line       + overlay `agent.x.model` -> overlay wins
  //
  // So `agent.<name>.model` here only sets a DEFAULT for agents whose .md omits `model:`.
  //
  // To actually run this kit's agents on your own (e.g. paid) models, pick one:
  //
  //   1. Personal global agent set — RECOMMENDED. Copy the kit's .opencode/agent/*.md to
  //      ~/.config/opencode/agent/ and rewrite `model:`/`fallback:` there. A project's
  //      .opencode/agent/<name>.md SHADOWS the global file of the same name, so those agents
  //      apply in every project EXCEPT one that ships its own — this repo keeps demonstrating
  //      the free tier while your other work runs on your models. (Verified.)
  //
  //   2. Edit .opencode/agent/*.md in your own clone and keep the diff local.
  //
  // Provider-level overrides (baseURL, credentials, extra models) DO work from here — that is
  // what the `provider` block above is for.
}
